          { "text": "STOP_PB를 누르면 MOTOR가 꺼진다.", "must_pass": true },
          { "text": "EMG가 눌리면 모든 출력이 꺼지고, 해제 후 START_PB를 다시 눌러야 기동한다.", "must_pass": true }
        ]
      }
    },
